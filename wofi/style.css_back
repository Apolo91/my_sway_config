#entry{
	padding: 0.25em;
}

#entry:selected {
	background-color: #bbccdd;
	color: white;
	border-radius:0px;
}

#expander-box {
	background-color: rgba(40, 44, 52, 0.9);
}

#text:selected {
	color: #333333;
}

#input{
	background-color: rgba(40, 44, 52, 0.5);
	color: white;
	padding: 0.25em;
}

image{
	margin-left: 0.25em;
	margin-right: 0.25em;
}
