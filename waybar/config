{
  "layer": "top",
  "position": "top",
  "spacing" : 0,
  "modules-left": ["custom/logout","sway/workspaces","sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["sway/language","pulseaudio","backlight","battery","network","tray"],
  "clock": {
    "format": "{:%H:%M | %d-%m-%Y}",
   },
   "cpu": {
    "format": " {usage}%"
   },
  "sway/language": {
    "format": "{short} {variant}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
  },
  "sway/workspaces": {
   "format": "{icon}",
   "on-click": "activate",
   "format-icons": {
    "1": "I",
    "2": "II",
    "3": "III",
    "4": "IV",
    "5": "V",
    "6": "VI",
    "7": "VII",
    "8": "VIII",
    "9": "IX",
    "10": "X",
   },
   "sort-by-number": true,
   "persistent-workspaces": {
    "1": "I",
    "2": "II",
    "3": "III",
    "4": "IV",
    "5": "V",
    "6": "VI",
    },
    "disable-scroll": true,
    "all-outputs": true,
    "show-special": true
  },
 "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["","","","",""]
  },
  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " {ifname}: {ipaddr}",
    "format-disconnected": "⚠ Disconnected",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
    "default": ["","",""]
    },
    "format-muted": " muted",
    "on-click": "pavucontrol"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["", ""]
  },
  "custom/logout": {
    "format": "",
    "tooltip": "Logout",
    "on-click": "wlogout"
  },
 "tray": {
    "icon-size": 18,
    "spacing": 10
 }
}

